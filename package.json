{
  "name": "influcine",
  "private": true,
  "version": "0.2.3",
  "description": "Influcine - Your Personal Streaming Companion",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mbstudio101/influcine"
  },
  "author": "Marvens",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tv:sync": "npm run build:web && npx cap sync android",
    "tv:android:debug": "npm run tv:sync && cd android && ./gradlew assembleDebug",
    "tv:android:release": "npm run tv:sync && cd android && ./gradlew assembleRelease bundleRelease",
    "tv:artifacts": "bash scripts/tv_collect_artifacts.sh",
    "tv:release": "npm run tv:android:release && npm run tv:artifacts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.1",
    "@supabase/supabase-js": "^2.91.1",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tauri-apps/api": "^2.0.0",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "framer-motion": "^12.29.0",
    "lucide-react": "^0.562.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.1.0",
    "react-router-dom": "^7.12.0",
    "react-virtuoso": "^4.18.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "^2.1.9"
  }
}
